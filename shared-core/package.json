{
  "name": "@chromatic-concordance/shared-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared TypeScript models and types for Chromatic Concordance UI, Nexus, Prestige Console, and Concept Game",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "chromatic-concordance",
    "types",
    "shared",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "5.9.3"
  }
}
